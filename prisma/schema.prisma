generator client {
  provider = "prisma-client-js"
  // Workspace path so editors resolve model types without relying on node_modules/.prisma
  output   = "../lib/prisma-generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Neon/pgBouncer pooler URLs (transaction pooling) can break Prisma migrate advisory locks.
  // Set DIRECT_DATABASE_URL to the non-pooler connection string for migrations.
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  DEVELOPER
  DIGITAL_MARKETER
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  /// Lowercase login handle; sign in with this or with email. Optional for legacy rows.
  username          String?   @unique @map("username")
  passwordHash      String    @map("password_hash")
  name              String?
  /// All dashboard and API access; enforced in application code. PostgreSQL `Role` enum in DB.
  role              Role      @default(DEVELOPER)
  createdById       String?   @map("created_by_id")
  createdAtIST      String?   @map("created_at_ist")
  createdAtET       String?   @map("created_at_et")
  passwordChangedAt DateTime? @map("password_changed_at")
  sessionRevokedAt  DateTime? @map("session_revoked_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  loginLogs                  LoginLog[]
  passwordChangeLogs         PasswordChangeLog[]      @relation("PasswordChangeTarget")
  adminEmployeeCreateOtps    AdminEmployeeCreateOtp[]
  newsPosts                  News[]
  invitesCreated             UserInvite[]             @relation("InviteCreator")
  notifications              Notification[]
  dashboardVisits            DashboardVisit[]
  contentEditLogs            ContentEditLog[]
  marketingActivityLogs      MarketingActivityLog[]
  errorLogs                  ErrorLog[]
  webVitalReports            WebVitalReport[]
}

model UserInvite {
  id            String   @id @default(cuid())
  email         String
  role          Role
  tokenHash     String   @map("token_hash")
  invitedById   String?  @map("invited_by_id")
  invitedBy     User?    @relation("InviteCreator", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt     DateTime @map("expires_at")
  usedAt        DateTime? @map("used_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([email, expiresAt])
  @@index([invitedById, createdAt])
  @@map("user_invite")
}

/// In-app notifications (per user). `type` / `title` / `body` are legacy; `message` is optional one-line text.
/// `read` is the boolean flag; `readAt` is optional timestamp of when it was read.
model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?   @db.Text
  /// Optional short line (e.g. push-style); if null, clients may use `title` and `body`.
  message   String?   @db.Text
  linkHref  String?   @map("link_href")
  read      Boolean   @default(false) @map("read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@index([userId, read])
  @@map("notification")
}

model AuditLog {
  id            String   @id @default(cuid())
  actorUserId   String?  @map("actor_user_id")
  actorEmail    String?  @map("actor_email")
  actorRole     String?  @map("actor_role")
  action        String
  targetType    String?  @map("target_type")
  targetId      String?  @map("target_id")
  targetLabel   String?  @map("target_label")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  payloadJson   String?  @map("payload_json") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_log")
}

model DbBackup {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now()) @map("created_at")
  createdById   String?  @map("created_by_id")
  createdByEmail String? @map("created_by_email")
  createdByRole String?  @map("created_by_role")
  label         String?  // optional note (e.g. "pre-restore", "manual")
  format        String   @default("json") // future-proof
  includeMedia  Boolean  @default(false) @map("include_media")
  sha256        String
  sizeBytes     Int      @map("size_bytes")
  dataJson      String   @db.Text @map("data_json")

  @@index([createdAt])
  @@index([createdById, createdAt])
  @@map("db_backup")
}

/// Pending employee row + OTP emailed to admin before POST /api/users finalizes create.
model AdminEmployeeCreateOtp {
  id           String   @id @default(cuid())
  adminUserId  String   @map("admin_user_id")
  adminUser    User     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  codeHash     String   @map("code_hash")
  expiresAt    DateTime @map("expires_at")
  email        String
  username     String
  passwordHash String   @map("password_hash")
  name         String?
  role         Role
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([adminUserId, expiresAt])
  @@map("admin_employee_create_otp")
}

model LoginLog {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  loggedAt      DateTime  @default(now()) @map("logged_at")
  loggedAtIST   String    @map("logged_at_ist")
  loggedAtET    String    @map("logged_at_et")
  loggedOutAt   DateTime? @map("logged_out_at")
  loggedOutAtIST String?  @map("logged_out_at_ist")
  loggedOutAtET String?   @map("logged_out_at_et")

  developerPageViews DeveloperPageView[]
}

model PasswordChangeLog {
  id           String   @id @default(cuid())
  changedById  String   @map("changed_by_id")
  targetUserId String   @map("target_user_id")
  targetUser   User     @relation("PasswordChangeTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  changedByRole String  @map("changed_by_role")
  changedAt    DateTime @default(now()) @map("changed_at")
  changedAtIST String  @map("changed_at_ist")
  changedAtET  String  @map("changed_at_et")
}

model Visit {
  id           String   @id @default(cuid())
  visitedAt    DateTime @map("visited_at")
  visitedAtIST String   @map("visited_at_ist")
  visitedAtET  String   @map("visited_at_et")
  ipAddress    String?  @map("ip_address")
  pagePath     String?  @map("page_path")
  userAgent    String?  @map("user_agent")

  @@index([visitedAt(sort: Desc)])
  @@index([pagePath, visitedAt])
}

model DashboardVisit {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  path         String
  role         Role
  visitedAt    DateTime @map("visited_at")
  visitedAtIST String   @map("visited_at_ist")
  visitedAtET  String   @map("visited_at_et")
  userAgent    String?  @map("user_agent")

  @@index([userId, visitedAt])
}

model DeveloperPageView {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  loginLogId   String?   @map("login_log_id")
  loginLog     LoginLog? @relation(fields: [loginLogId], references: [id], onDelete: SetNull)
  path         String
  visitedAt    DateTime  @map("visited_at")
  visitedAtIST String    @map("visited_at_ist")
  visitedAtET  String    @map("visited_at_et")
  userAgent    String?   @map("user_agent")
}

model PageContent {
  id        String   @id @default(cuid())
  pageKey   String   @map("page_key")
  slug      String   @unique
  locale    String   @default("en")
  title     String
  body      String   @db.Text
  status    PageStatus @default(published)
  scheduledPublishAt DateTime? @map("scheduled_publish_at")
  metaTitle       String? @map("meta_title")
  metaDescription String? @map("meta_description")
  keywords        String?
  canonicalUrl    String? @map("canonical_url")
  ogTitle         String? @map("og_title")
  ogDescription   String? @map("og_description")
  ogImage         String? @map("og_image")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([pageKey, locale])
}

/// Public careers listings (`/careers`). Managed from Developer / Admin / Marketer dashboards.
model CareerJob {
  id        String     @id @default(cuid())
  slug      String     @unique
  sortOrder Int        @default(0) @map("sort_order")
  status    PageStatus @default(published)
  /// Comma-separated subset of en,te,hi — languages offered for this role on the apply form.
  applyLanguageCodesCsv String @default("en,te,hi") @map("apply_language_codes_csv")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  translations CareerJobTranslation[]

  @@map("career_job")
}

model CareerJobTranslation {
  id          String    @id @default(cuid())
  jobId       String    @map("job_id")
  job         CareerJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  locale      String
  title       String
  subtitle    String
  description String    @db.Text
  applyLabel  String    @default("Apply") @map("apply_label")
  applyUrl    String    @map("apply_url")

  @@unique([jobId, locale])
  @@index([locale])
  @@map("career_job_translation")
}

enum PageStatus {
  draft
  published
}

enum NewsStatus {
  draft
  published
  scheduled
  archived
}

enum NewsContentType {
  blog
  case_study
  news
  guide
}

model News {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  content         String     @db.Text
  excerpt         String?    @db.Text
  featuredImage   String?    @map("featured_image")
  featuredImageAlt String?  @map("featured_image_alt")
  bannerImage     String?    @map("banner_image")
  galleryImageUrls String?   @map("gallery_image_urls") @db.Text
  embeddedVideoUrl String?   @map("embedded_video_url")
  infographicUrls String?    @map("infographic_urls") @db.Text
  authorId        String     @map("author_id")
  author          User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorDisplayName String?  @map("author_display_name")
  authorBio       String?    @map("author_bio") @db.Text
  sectorId        String?    @map("sector_id")
  sector          Sector?    @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  status          NewsStatus @default(draft)
  publishedAt     DateTime?  @map("published_at")
  scheduledPublishAt DateTime? @map("scheduled_publish_at")
  metaTitle       String?    @map("meta_title")
  metaDescription String?    @map("meta_description")
  keywords        String?
  focusKeyword    String?    @map("focus_keyword")
  secondaryKeywords String?  @map("secondary_keywords") @db.Text
  canonicalUrl    String?    @map("canonical_url")
  breadcrumbTitle String?    @map("breadcrumb_title")
  metaRobots      String?    @map("meta_robots")
  categorySlugs   String?    @map("category_slugs") @db.Text
  tags            String?    @db.Text
  subCategory     String?    @map("sub_category")
  contentType     NewsContentType @default(blog) @map("content_type")
  ogTitle         String?    @map("og_title")
  ogDescription   String?    @map("og_description")
  ogImage         String?    @map("og_image")
  viewCount       Int        @default(0) @map("view_count")
  likeCount       Int        @default(0) @map("like_count")
  shareCount      Int        @default(0) @map("share_count")
  commentsEnabled Boolean  @default(true) @map("comments_enabled")
  readingTimeMinutes Int?    @map("reading_time_minutes")
  articleSchemaJson String?  @map("article_schema_json") @db.Text
  faqSchemaJson   String?    @map("faq_schema_json") @db.Text
  howToSchemaJson String?    @map("how_to_schema_json") @db.Text
  relatedPostSlugs String?   @map("related_post_slugs") @db.Text
  pillarSlug      String?    @map("pillar_slug")
  outboundLinksJson String?  @map("outbound_links_json") @db.Text
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  translations    NewsTranslation[]

  @@index([authorId])
  @@index([sectorId])
  @@map("news")
}

// Auto-generated from the canonical English row when a post is published (dashboard).
model NewsTranslation {
  id               String   @id @default(cuid())
  newsId           String   @map("news_id")
  news             News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  locale           String
  title            String
  content          String   @db.Text
  excerpt          String?  @db.Text
  translatedSlug   String?  @map("translated_slug")
  hreflangJson     String?  @map("hreflang_json") @db.Text
  metaTitle        String?  @map("meta_title")
  metaDescription  String? @map("meta_description")
  ogTitle          String?  @map("og_title")
  ogDescription    String?  @map("og_description")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([newsId, locale])
  @@index([newsId])
  @@map("news_translation")
}

model Sector {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  isLive      Boolean  @default(false) @map("is_live")
  createdAt   DateTime @default(now()) @map("created_at")

  news News[]

  companies Company[]
}

model Company {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoImage   String?  @map("logo_image")
  heroImage   String?  @map("hero_image")
  websiteUrl  String?  @map("website_url")
  description String?  @db.Text
  aboutContent String? @db.Text @map("about_content")

  facebookUrl  String? @map("facebook_url")
  instagramUrl String? @map("instagram_url")
  xUrl         String? @map("x_url")
  youtubeUrl   String? @map("youtube_url")
  pinterestUrl String? @map("pinterest_url")

  sectorId String @map("sector_id")
  sector   Sector @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sectorId])
  @@map("company")
}

/// Lead / contact submissions from public company pages (`/companies/[slug]`).
model CompanyFormSubmission {
  id          String   @id @default(cuid())
  formType    String   @map("form_type")
  companySlug String?  @map("company_slug")
  sectorSlug  String?  @map("sector_slug")
  email       String
  fullName    String?  @map("full_name")
  payloadJson String   @map("payload_json") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([formType, createdAt(sort: Desc)])
  @@index([companySlug, createdAt(sort: Desc)])
  @@map("company_form_submission")
}

enum CampaignStatus {
  draft
  active
  paused
  ended
}

model Campaign {
  id          String          @id @default(cuid())
  name        String
  description String          @default("")
  url         String
  status      CampaignStatus  @default(draft)
  startDate   DateTime?       @map("start_date")
  endDate     DateTime?       @map("end_date")
  createdById String?         @map("created_by_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
}

enum MarketingLinkType {
  tool
  integration
  resource
  other
}

model MarketingLink {
  id          String            @id @default(cuid())
  name        String
  url         String
  description String            @default("")
  type        MarketingLinkType @default(resource)
  createdById String?           @map("created_by_id")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
}

model ContentEditLog {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userEmail  String   @map("user_email")
  userRole   String   @map("user_role")
  kind       String   @map("kind")
  targetPath String   @map("target_path")
  summary    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
}

model MarketingActivityLog {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userEmail   String   @map("user_email")
  userRole    String   @map("user_role")
  entity      String   @map("entity")
  entityId    String   @map("entity_id")
  action      String   @map("action")
  seoNote     String?  @map("seo_note") @db.Text
  payloadJson String?  @map("payload_json") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
}

model WebVitalReport {
  id             String   @id @default(cuid())
  name           String
  value          Float
  rating         String?
  delta          Float?
  idMetric       String?  @map("id_metric")
  navigationType String?  @map("navigation_type")
  pagePath       String?  @map("page_path")
  userId         String?  @map("user_id")
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@index([name, createdAt])
}

model ErrorLog {
  id String @id @default(cuid())

  userId    String? @map("user_id")
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail String? @map("user_email")
  userRole  String? @map("user_role")

  path       String? @map("path")
  method     String? @map("method")
  statusCode Int?    @map("status_code")
  errorType  String? @map("error_type")

  message    String  @db.Text
  stackTrace String? @db.Text @map("stack_trace")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
}

/// Build / deploy triggers from the developer dashboard (audit log only).
/// `id` is a string UUID for new rows (v4) when created via Prisma; legacy rows may be cuid.
model Deployment {
  id        String   @id @default(uuid())
  status    String   @map("status")
  logs      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@map("deployment")
}

/// Binary image assets served via GET /api/media/{key} (key = path relative to /public, POSIX slashes).
model StoredImage {
  id        String   @id @default(cuid())
  key       String   @unique
  altText   String?  @map("alt_text")
  fileName  String?  @map("file_name")
  size      Int?
  mimeType  String   @map("mime_type")
  data      Bytes
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("stored_image")
}

/// Public `/team` roster (founder + developers + marketers). Managed from admin dashboard.
enum TeamMemberSection {
  FOUNDER
  DEVELOPER
  MARKETER
}

model TeamMember {
  id                 String             @id @default(cuid())
  section            TeamMemberSection  @map("section")
  sortOrder          Int                @default(0) @map("sort_order")
  name               String
  designation        String             @map("designation")
  /// Main bio (max 200 words enforced in API).
  description        String             @map("description") @db.Text
  /// Optional second paragraph (e.g. founder).
  descriptionExtra   String?            @map("description_extra") @db.Text
  /// Public image URL: `/founder.webp` or `/api/media/...` from StoredImage.
  imageUrl           String             @map("image_url")
  imageAlt           String?            @map("image_alt")
  /// Pan / zoom in the square holder (percent and scale).
  imageOffsetX       Float              @default(0) @map("image_offset_x")
  imageOffsetY       Float              @default(0) @map("image_offset_y")
  imageScale         Float              @default(1) @map("image_scale")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@index([section, sortOrder])
  @@map("team_member")
}

model FeatureToggle {
  id          String   @id @default(cuid())
  name        String   @unique
  enabled     Boolean  @default(false)
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("feature_toggle")
}

model RoleModulePermission {
  id        String   @id @default(cuid())
  role      Role
  module    String
  allowed   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([role, module])
  @@index([role])
  @@map("role_module_permission")
}
