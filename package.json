{
  "name": "doddapaneni-group",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 115",
    "safari >= 16.4",
    "ios_saf >= 16.4"
  ],
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev",
    "prebuild": "prisma generate && node scripts/sync-content-translations.mjs && node scripts/validate-translation-coverage.mjs",
    "build": "next build",
    "start": "node scripts/start-production.mjs",
    "start:next": "next start -H 0.0.0.0",
    "lint": "eslint",
    "i18n:sync": "node scripts/sync-locales.mjs",
    "i18n:content-sync": "node scripts/sync-content-translations.mjs && node scripts/validate-translation-coverage.mjs",
    "i18n:translate": "node scripts/translate-all-locales.mjs",
    "i18n:translate-blog": "node scripts/translate-blog-content.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:delete-flagship-companies": "node scripts/delete-flagship-companies.mjs",
    "db:sync-sectors": "node scripts/sync-canonical-sectors.mjs",
    "db:seed:blogs": "node scripts/seed-division-blogs.mjs",
    "db:import-static-news": "npx tsx scripts/import-doddapaneni-news-to-db.ts",
    "db:news:delete-in-divisions": "node scripts/delete-news-blogs-in-divisions.mjs",
    "db:reset": "node scripts/reset-and-seed.mjs",
    "db:push": "prisma db push",
    "db:push:turso": "node scripts/db-push-turso.mjs",
    "db:seed:turso": "node scripts/db-seed-turso.mjs",
    "db:seed:team": "npx tsx scripts/seed-team-members.ts",
    "media:seed": "node scripts/seed-stored-images.mjs",
    "images:optimize": "node scripts/convert-images-to-webp.mjs",
    "images:recompress-webp": "OPTIMIZE_EXISTING_WEBP=1 node scripts/convert-images-to-webp.mjs",
    "postinstall": "prisma generate",
    "prepare": "prisma generate"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-libsql": "6.19.3",
    "@prisma/client": "6.19.3",
    "@tiptap/extension-placeholder": "^3.22.4",
    "@tiptap/extension-text-align": "^3.22.4",
    "@tiptap/pm": "^3.22.4",
    "@tiptap/react": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "critters": "^0.0.23",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.29.2",
    "lucide-react": "^0.563.0",
    "next": "^16.2.1",
    "next-auth": "^5.0.0-beta.30",
    "nodemailer": "^7.0.13",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-easy-crop": "^5.5.7",
    "react-hook-form": "^7.71.1",
    "recharts": "^3.7.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.4.0",
    "web-vitals": "^5.1.0",
    "zod": "^4.3.6"
  },
  "prisma": {
    "seed": "node scripts/seed.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
