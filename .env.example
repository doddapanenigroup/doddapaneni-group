# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
# If send fails with connection timeout, try: SMTP_PORT=587 and SMTP_SECURE=false
# If password has # some panels truncate EMAIL_PASS — use base64 instead:
#   printf '%s' 'your-real-password' | base64
# EMAIL_PASS_B64=paste_output_here

# Email credentials
EMAIL_USER=info@example.com
EMAIL_PASS=your_mailbox_password

# NextAuth (required for login)
# Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Preview token signing secret (used for /preview/[token] draft previews)
# If not set, AUTH_SECRET is used as a fallback.
PREVIEW_SECRET=

# Scheduled publishing (cron trigger for scheduledPublishAt)
# This secures GET /api/cron/publish-scheduled. In production it is required.
# Your cron should send header: x-cron-secret: <CRON_SECRET>
# Also used for: GET /api/cron/cleanup-expired-otps
CRON_SECRET=

# NextAuth URL (required in production if behind a proxy)
# For localhost: http://localhost:3000
# For production: https://yourdomain.com
NEXTAUTH_URL=https://yourdomain.com
# Reset-and-seed script: Super Admin user (set in .env.local, never commit real values)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me
SUPER_ADMIN_NAME=Admin

# PostgreSQL (required) — use this same URL in Hostinger env vars
# Local Postgres: do not use sslmode=require (default install has no TLS).
# Remote/managed DB: add &sslmode=require to the URL when the provider requires SSL.
#
# Neon: Prefer the *pooler* / "transaction" connection string for DATABASE_URL (host often ends in
# -pooler or pooler.neon.tech). It reduces "connection closed" / idle dropped sockets in Next.js dev.
# Prisma migrations: pooler URLs can break advisory locks. Set DIRECT_DATABASE_URL to the *direct* (non-pooler)
# connection string so `npx prisma migrate deploy` can run reliably.
# Neon: Dashboard → your branch → Connect → copy "Direct connection" for DIRECT_DATABASE_URL (host usually has no
# `-pooler` in the name). Keep "Pooled" / pooler URL as DATABASE_URL for the app.
# If migrate still errors with P1002 (advisory lock timeout): ensure DIRECT_DATABASE_URL is set and not the pooler
# URL; wait a minute and retry; stop any other `migrate` or IDE Prisma migrate running against the same DB.
# Optionally append: &connect_timeout=30 (supported query params vary by host).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# Optional: merge into dashboard keyboard shortcuts (see lib/keyboard-shortcuts-config.ts).
# Example: {"search":{"enabled":false},"save":{"binding":{"key":"s","mod":true,"shift":true}}}
# NEXT_PUBLIC_DASHBOARD_KEYBOARD_SHORTCUTS_JSON=

# Google Analytics (GA4)
# Create a GA4 property → Data streams → Web → copy the "Measurement ID" (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-H4S3KYSL13
# Set to 1 to disable GA in the browser (cleaner Lighthouse/GTmetrix — no tracking while enabled)
# NEXT_PUBLIC_DISABLE_GA=1

# Canonical origin for sitemap.xml + robots.txt (matches lib/site-origin.ts). Set in production.
NEXT_PUBLIC_SITE_URL=https://doddapanenigroup.net
#
# Google Search Console HTML tag (optional; falls back to built-in default in lib/google-site-verification.ts)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_verification_token

# Public URLs: English has no /en prefix (https://YOUR_DOMAIN/, /about). Other locales: /te/…, /hi/…, /es/….
#
# SEO: This app serves https://YOUR_DOMAIN/sitemap.xml and /robots.txt (see app/sitemap.ts, app/robots.ts).
# Submit that sitemap URL in Google Search Console / Bing Webmaster — no third-party crawler required.
# If tools (e.g. xml-sitemaps.com) report HTTP 403, the block is usually Cloudflare/hosting bot rules or
# IP reputation, not missing files. That same block stops Google/Bing from crawling: they get a challenge
# page with noindex, not your real HTML. In Cloudflare: allow verified bots, or add WAF skip rules for
# /robots.txt, /sitemap.xml, and document HTML routes; disable “Under Attack” unless you need it.

#npx prisma db push
#npm run db:seed    # or npm run db:reset for a full wipe + super-admin only 
