# Hostinger example (uncomment and adjust)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Aliases also supported: SMTP_USER, SMTP_PASS, GMAIL_APP_PASSWORD

