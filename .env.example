# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
# Yahoo Mail (not @yahoo.com “smtp.yahoo.com” — use this host):
# SMTP_HOST=smtp.mail.yahoo.com
# SMTP_PORT=465
# SMTP_SECURE=true
# If send fails with connection timeout, try: SMTP_PORT=587 and SMTP_SECURE=false
# If password has # some panels truncate EMAIL_PASS — use base64 instead:
#   printf '%s' 'your-real-password' | base64
# EMAIL_PASS_B64=paste_output_here
# If B64 is set but decodes to empty, `EMAIL_PASS` is still used (stale B64 no longer blocks mail).

# Email credentials
EMAIL_USER=info@example.com
EMAIL_PASS=your_mailbox_password

# Careers: optional — where to send each application (full form + resume). If unset, uses EMAIL_USER only.
# For Yahoo-only (e.g. doddapanenigroup@yahoo.com): set EMAIL_USER to that address and leave this unset.
# The app then sends to doddapanenigroup+dg-careers@yahoo.com (same inbox; reliable when From === mailbox).
# CAREERS_ADMIN_NOTIFY_EMAIL=other-inbox@example.com

# Development only — persist applications without sending email (never enable in production).
# CAREERS_APPLY_DEV_NO_EMAIL=1
#
# With `npm run dev`, if outbound mail is not configured, the API still saves the application and returns success.
# Inbox SMTP failures always return an error so misconfiguration is visible.

# NextAuth (required for login)
# Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Preview token signing secret (used for /preview/[token] draft previews)
# If not set, AUTH_SECRET is used as a fallback.
PREVIEW_SECRET=

# Scheduled publishing (cron trigger for scheduledPublishAt)
# This secures GET /api/cron/publish-scheduled. In production it is required.
# Your cron should send header: x-cron-secret: <CRON_SECRET>
# Also used for: GET /api/cron/cleanup-expired-otps
CRON_SECRET=

# NextAuth URL (required in production if behind a proxy)
# Must match the exact origin users open in the browser (scheme + host, no trailing slash) or login/dashboard bounce.
# For localhost: http://localhost:3000
# For production: https://yourdomain.com
NEXTAUTH_URL=https://yourdomain.com
# Primary Admin user for seed/reset (role ADMIN; env names kept for compatibility)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin
# Optional seed accounts (defaults in scripts/seed.mjs if unset)
# ADMIN_EMAIL=admin@yourdomain.com
# DEVELOPER_EMAIL=developer@yourdomain.com
# MARKETER_EMAIL=marketer@yourdomain.com
# SEED_PASSWORD=shared-default-for-admin-developer-marketer-when-not-using-per-role-passwords

# Database — **one URL for everything** (dashboard, API, public pages, `npx prisma db push`, seeds).
# `prisma/schema.prisma` keeps a placeholder `file:` URL for Prisma 6; the real connection is `DATABASE_URL` here.
#
# Local development (SQLite file under `prisma/`):
#   DATABASE_URL=file:./dev.db
#   (leave TURSO_AUTH_TOKEN unset)
#
# Turso / hosted LibSQL (use the URL from Turso dashboard → database → libsql):
#   DATABASE_URL=libsql://your-db-name-your-org.aws-us-east-1.turso.io
#   TURSO_AUTH_TOKEN=...    # `turso db tokens create <db-name>`
#
# After changing DATABASE_URL: restart `npm run dev` so Next.js picks it up.
#
DATABASE_URL=file:./dev.db
TURSO_AUTH_TOKEN=

# Blog machine translation (MyMemory API). Unset or non-zero: enabled. Set to 0 to disable auto-translate and the dashboard “Translate languages” action.
# BLOG_AUTO_TRANSLATE=0
# Optional delay (ms) between translation calls to reduce rate limits (default 400).
# TRANSLATE_DELAY_MS=600

# Optional: merge into dashboard keyboard shortcuts (see lib/keyboard-shortcuts-config.ts).
# Example: {"search":{"enabled":false},"save":{"binding":{"key":"s","mod":true,"shift":true}}}
# NEXT_PUBLIC_DASHBOARD_KEYBOARD_SHORTCUTS_JSON=

# Google Analytics (GA4)
# Create a GA4 property → Data streams → Web → copy the "Measurement ID" (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-H4S3KYSL13
# Set to 1 to disable GA in the browser (cleaner Lighthouse/GTmetrix — no tracking while enabled)
# NEXT_PUBLIC_DISABLE_GA=1

# Canonical origin for robots.txt (`Host:` + `Sitemap:`) and absolute URLs. Use your real hostname (www or apex).
NEXT_PUBLIC_SITE_URL=https://www.doddapanenigroup.net
#
# Google Search Console HTML tag (optional; falls back to built-in default in lib/google-site-verification.ts)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_verification_token

# Public URLs: English has no /en prefix (https://YOUR_DOMAIN/, /about). Other locales: /te/…, /hi/…, /es/….
#
# SEO: Static sitemap is `public/sitemap.xml` (served as `/sitemap.xml`). `app/robots.ts` points crawlers there.
# If crawlers get HTTP 403, check Cloudflare/hosting bot rules and WAF for `/sitemap.xml`, `/robots.txt`, and HTML routes.

#npx prisma db push
# npm run db:seed   # upserts seed users (SUPER_ADMIN_EMAIL / ADMIN_EMAIL, etc.) so DB matches .env
# or npm run db:reset for a full wipe + one Admin user only
